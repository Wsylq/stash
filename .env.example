# Host port that Stash's web UI listens on.
STASH_PORT=3000

# Secret used to encrypt AI API keys and sign sessions.
# If left empty, Stash generates one and stores it in the data volume
# under .secret. Setting it lets you skip the first-run secret generation.
STASH_SECRET=

# The first registered account is always allowed (bootstrap).
# Set to true to keep allowing new account registrations afterwards.
STASH_ALLOW_SIGNUP=false